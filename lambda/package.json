{
  "name": "sla-ingest-lambda",
  "version": "1.0.0",
  "private": true,
  "description": "Stateless AWS Lambda that parses, validates, cleans and persists SLA health-check CSVs",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "prisma": {
    "schema": "../prisma/schema.prisma"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "test": "node --test \"test/**/*.test.js\"",
    "dev": "node --env-file=../.env scripts/dev-server.mjs",
    "package": "node scripts/package.mjs",
    "deploy": "node --env-file-if-exists=../.env scripts/deploy.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@aws-sdk/client-iam": "^3.1169.0",
    "@aws-sdk/client-lambda": "^3.1169.0",
    "adm-zip": "^0.6.1",
    "prisma": "6.19.3"
  }
}
