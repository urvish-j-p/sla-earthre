{
  "name": "sla-dashboard-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-samples.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-samples.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test \"src/**/*.test.js\"",
    "postinstall": "prisma generate",
    "db:migrate": "node --env-file-if-exists=../.env --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node --env-file-if-exists=../.env --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate deploy",
    "db:studio": "node --env-file-if-exists=../.env --env-file-if-exists=.env.local node_modules/prisma/build/index.js studio"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@prisma/client": "6.19.3",
    "antd": "^6.7.0",
    "dayjs": "^1.11.23",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3"
  },
  "engines": {
    "node": ">=22"
  },
  "prisma": {
    "schema": "../prisma/schema.prisma"
  }
}
