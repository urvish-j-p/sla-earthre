# ---- Database (Prisma Postgres, or any Postgres) ----
# Used by the Lambda, the Next.js app and `prisma migrate`.
# Prisma Postgres: copy the direct "postgres://...@db.prisma.io:5432/..." string.
# Local:           postgresql://postgres:<password>@localhost:5432/sla_dev
DATABASE_URL="postgres://user:password@db.prisma.io:5432/postgres?sslmode=require"

# ---- Web app ----
# Public URL of the deployed ingest Lambda (Function URL). Locally: http://localhost:3001
NEXT_PUBLIC_INGEST_URL="http://localhost:3001"

# ---- Lambda deploy (scripts/deploy.mjs) ----
AWS_REGION="ap-south-1"
# Origin(s) allowed to call the Function URL (comma separated)
INGEST_ALLOWED_ORIGINS="http://localhost:3000"
# Credentials are read from the standard AWS chain (env vars or ~/.aws/credentials)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
