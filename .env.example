# ---- Database (Neon / any Postgres) ----
# Pooled connection string, used by the Lambda and the Next.js app at runtime.
# For Neon use the "-pooler" host and append: ?sslmode=require&pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://user:password@host:5432/sla?sslmode=require&pgbouncer=true&connection_limit=1"
# Direct (non-pooled) connection string, used only by `prisma migrate`.
DIRECT_URL="postgresql://user:password@host:5432/sla?sslmode=require"

# ---- Web app ----
# Public URL of the deployed ingest Lambda (Function URL). Locally: http://localhost:3001
NEXT_PUBLIC_INGEST_URL="http://localhost:3001"

# ---- Lambda deploy (scripts/deploy.mjs) ----
AWS_REGION="ap-south-1"
# Origin(s) allowed to call the Function URL (comma separated)
INGEST_ALLOWED_ORIGINS="http://localhost:3000"
# Credentials are read from the standard AWS chain (env vars or ~/.aws/credentials)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
